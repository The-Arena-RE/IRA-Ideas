---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Services from '../components/Services.astro';
import PhotoCollage from '../components/PhotoCollage.astro';
import VideoCard from '../components/VideoCard.astro';
import Faq from '../components/Faq.astro';
import Testimonials from '../components/Testimonials.astro';
import ContactForm from '../components/ContactForm.astro';
import tim from '../assets/img/tim-hero.png';
import avatars from '../assets/img/client-avatars.png';
import badge from '../assets/img/badge-icon.png';
import heroBg from '../assets/img/couple-agent.jpg';
import { videos, BOOKING_URL } from '../data/site';

const heroBgImg = await getImage({ src: heroBg, width: 1920, format: 'webp' });
---

<Base
  title="Self Directed IRA Attorney | Expert Self-Directed 401(k) Lawyer | IRA Ideas LLC"
  description="Work with a Self Directed IRA attorney for compliant self-directed IRA and 401(k) strategies. Get legal guidance on prohibited transactions, rollovers, and investment structures."
>
  <!-- Hero -->
  <section
    class="edge-angle relative overflow-hidden bg-teal-950 bg-cover bg-center text-white"
    style={`background-image: linear-gradient(rgba(0,58,58,.86), rgba(0,58,58,.86)), url(${heroBgImg.src});`}
  >
    <div class="container-site grid items-end gap-8 pt-14 lg:grid-cols-[1.15fr_1fr] lg:pt-20">
      <div class="pb-28 lg:pb-40">
        <p class="text-sm font-bold tracking-wide uppercase">Tim Berry</p>
        <h1 class="mt-5 text-[44px] leading-[1.05] font-bold text-white sm:text-6xl lg:text-[73px]">
          <span class="text-amber-500">Self Directed IRA</span> &amp; <span class="text-amber-500">self-directed 401K</span> Attorney.
        </h1>
        <p class="mt-7 max-w-lg text-white">
          Hi, I’m <strong>Tim Berry</strong>, a <strong>Self-Directed IRA</strong> and <strong>self-directed 401(k)</strong>
          attorney with <strong>20 years of experience</strong> helping people take control of their retirement plans through
          <strong>compliant</strong>, <strong>tax-smart strategies.</strong>
        </p>
        <a href={BOOKING_URL} class="btn mt-8">Book An Appointment <span aria-hidden="true">→</span></a>

        <div class="mt-10 flex items-center gap-5">
          <Image src={avatars} alt="" width={260} class="h-auto w-[200px] sm:w-[260px]" />
          <p class="font-serif text-xl leading-tight font-semibold text-white">Clients All Across the Country</p>
        </div>
      </div>

      <div class="relative hidden self-end lg:block">
        <Image
          src={tim}
          alt="Tim Berry, self-directed IRA and 401(k) attorney"
          widths={[400, 600, 800]}
          sizes="(min-width: 1024px) 480px, 0px"
          class="mx-auto h-auto w-full max-w-[480px]"
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </div>
  </section>

  <!-- Feature badges + Quick Contact -->
  <section class="relative">
    <div class="container-site grid gap-10 pb-16 lg:grid-cols-[1.15fr_1fr]">
      <div class="grid content-center gap-8 pt-10 sm:grid-cols-2 lg:pt-16">
        <div class="flex items-center gap-4">
          <Image src={badge} alt="" width={88} class="size-[88px] shrink-0" />
          <div>
            <h2 class="font-sans text-[17px] font-bold text-ink">Prohibited Transactions?</h2>
            <p class="text-sm">We can help!</p>
          </div>
        </div>
        <div class="flex items-center gap-4">
          <Image src={badge} alt="" width={88} class="size-[88px] shrink-0" />
          <div>
            <h2 class="font-sans text-[17px] font-bold text-ink">5500ez issues</h2>
            <p class="text-sm">There’s hope. We can fight those penalties!</p>
          </div>
        </div>
      </div>

      <div class="relative z-10 border-[6px] border-white bg-teal-900 p-7 shadow-2xl lg:-mt-36 lg:p-9">
        <h2 class="font-sans text-xl font-bold text-white">Quick Contact</h2>
        <div class="mt-6">
          <ContactForm variant="quick" />
        </div>
      </div>
    </div>
  </section>

  <Services />

  <!-- About teaser -->
  <section class="py-20 md:py-28" aria-labelledby="about-heading">
    <div class="container-site grid items-center gap-14 lg:grid-cols-2">
      <PhotoCollage />
      <div>
        <p class="eyebrow">About me</p>
        <h2 id="about-heading" class="mt-3 text-4xl font-semibold md:text-[48px]">
          I know the ins and outs of retirement plans so you don't have to guess.
        </h2>
        <p class="mt-6">
          Chances are every exception has an exception. If you just read the tax code, there is a good chance you are still
          going to make a mistake.
        </p>
        <p class="mt-4">
          Don’t get me started on chatgpt either. . . I can’t tell you how many times it has created tax code sections out of
          the blue.
        </p>
        <a href={BOOKING_URL} class="btn mt-8">Book An Appointment <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- Videos teaser -->
  <section class="bg-soft py-20 md:py-24" aria-labelledby="videos-heading">
    <div class="container-site">
      <div class="grid items-end gap-6 lg:grid-cols-[1fr_auto]">
        <div class="max-w-2xl">
          <p class="eyebrow">Videos</p>
          <h2 id="videos-heading" class="mt-3 text-4xl font-semibold md:text-[48px]">Video Insights on Self-Directed IRAs &amp; 401(k)s</h2>
          <p class="mt-5">
            Watch concise videos where I explain self-directed IRAs, 401(k)s, and compliant retirement strategies in clear,
            practical terms to help you make informed decisions with confidence.
          </p>
        </div>
        <a href="/videos-ira-401k/" class="btn">See All Videos <span aria-hidden="true">→</span></a>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {videos.slice(0, 3).map((v) => <VideoCard {...v} author="Tim Berry" />)}
      </div>
    </div>
  </section>

  <Faq />
  <Testimonials />
</Base>
