---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Services from '../components/Services.astro';
import PhotoCollage from '../components/PhotoCollage.astro';
import Faq from '../components/Faq.astro';
import Testimonials from '../components/Testimonials.astro';
import tim from '../assets/img/tim-about.png';
import { BOOKING_URL } from '../data/site';
---

<Base
  title="Tim Berry – Legal Guidance for Self-Directed IRAs & 401(k)s | IRA Ideas LLC"
  description="Tim Berry is an attorney who has handled IRA and 401(k) issues since 1997, helping clients nationwide with self-directed IRAs, prohibited transactions, and compliant retirement strategies."
>
  <!-- Hero -->
  <section class="edge-angle bg-teal-950 text-white">
    <div class="container-site grid items-end gap-10 pt-14 lg:grid-cols-2">
      <div class="order-2 lg:order-1">
        <Image
          src={tim}
          alt="Tim Berry, attorney"
          widths={[400, 600, 800]}
          sizes="(min-width: 1024px) 460px, 80vw"
          class="mx-auto h-auto w-full max-w-[460px]"
          loading="eager"
          fetchpriority="high"
        />
      </div>
      <div class="order-1 pb-6 lg:order-2 lg:pb-32">
        <p class="text-sm font-semibold tracking-wide text-amber-500 uppercase">About me</p>
        <h1 class="mt-4 font-sans text-6xl leading-[0.95] font-bold text-white md:text-[110px]">TIM<br />BERRY</h1>
        <p class="mt-8 text-white">
          I’m an <strong>attorney</strong> who has been dealing with <strong>IRA</strong> and <strong>401k</strong> issues since
          1997. While I’m licensed as an attorney in <strong>Washington state</strong>, I work with clients all around the
          country by phone, fax, and email.
        </p>
        <p class="mt-4 text-white">
          For projects, I typically bill by the project, not the hour. That means you don’t have to worry about any unexpected
          huge bill, you know exactly the amount when I start work.
        </p>
        <a href={BOOKING_URL} class="btn mt-8">Book An Appointment <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <!-- Intro -->
  <section class="py-20 md:py-28">
    <div class="container-site grid items-center gap-14 lg:grid-cols-2">
      <PhotoCollage />
      <div>
        <h2 class="font-sans text-3xl font-bold md:text-[36px]">
          Translating the <span class="text-amber-500">complexities of prohibited transactions, unrelated business taxes, and
          self directed 401ks</span> so you don't run afoul of the law.
        </h2>
        <p class="mt-6">
          I simplify complex tax laws so you don’t have to worry about love letters from the IRS. With years of experience
          focused on self-directed IRAs, 401(k) strategies, and advanced tax planning, I provide clear, practical guidance that
          helps you protect your assets and move forward with confidence.
        </p>
        <a href={BOOKING_URL} class="btn mt-8">Book An Appointment <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <Services />
  <Faq />
  <Testimonials />
</Base>
