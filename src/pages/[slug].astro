---
// Blog posts live at the site root, matching the WordPress permalinks: /what-is-an-ira/
import type { GetStaticPaths } from 'astro';
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import timPhoto from '../assets/img/tim-about.png';
import { getPosts, postUrl, formatDate, readingTime, relatedPosts, CATEGORY_NAMES, type Post } from '../lib/blog';
import { BOOKING_URL, site } from '../data/site';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}) satisfies GetStaticPaths;

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const { title, description, pubDate, updatedDate, image, imageAlt, tags, categories } = post.data;
const posts = await getPosts();
const related = relatedPosts(post, posts);
const idx = posts.findIndex((p) => p.id === post.id);
const newer = posts[idx - 1];
const older = posts[idx + 1];

const ogImage = image ? (await getImage({ src: image, width: 1200, format: 'jpeg' })).src : undefined;
const url = new URL(postUrl(post), Astro.site).href;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  mainEntityOfPage: url,
  url,
  image: ogImage ? new URL(ogImage, Astro.site).href : undefined,
  author: { '@type': 'Person', name: 'Tim Berry', url: new URL('/about-tim-berry/', Astro.site).href },
  publisher: { '@type': 'Organization', name: site.name, url: 'https://iraideas.com/' },
  keywords: tags.map((t) => t.name).join(', ') || undefined,
};
---

<Base
  title={`${title} | IRA Ideas LLC`}
  description={description}
  image={ogImage}
  type="article"
  publishedTime={pubDate}
  modifiedTime={updatedDate}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article>
    <header class="bg-teal-950 pt-12 pb-16 text-white md:pt-16 md:pb-20">
      <div class="container-site max-w-4xl!">
        <nav aria-label="Breadcrumb" class="text-sm text-white/70">
          <a href="/" class="hover:text-amber-500">Home</a> <span aria-hidden="true">/</span>
          <a href="/blog/" class="hover:text-amber-500">Blog</a>
          {
            categories.map((c) => (
              <>
                {' '}
                <span aria-hidden="true">/</span>{' '}
                <a href={`/category/${c}/`} class="hover:text-amber-500">{CATEGORY_NAMES[c] ?? c}</a>
              </>
            ))
          }
        </nav>
        <h1 class="mt-5 text-4xl leading-tight font-bold text-white md:text-5xl">{title}</h1>
        <p class="mt-6 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-white/80">
          <span>By <a href="/about-tim-berry/" class="font-semibold text-white hover:text-amber-500">Tim Berry</a></span>
          <span aria-hidden="true">·</span>
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          <span aria-hidden="true">·</span>
          <span>{readingTime(post)} min read</span>
        </p>
      </div>
    </header>

    <div class="container-site max-w-4xl! pb-16">
      {
        image && (
          <Image
            src={image}
            alt={imageAlt ?? ''}
            widths={[640, 960, 1280]}
            sizes="(min-width: 960px) 896px, 100vw"
            class="-mt-8 w-full rounded-2xl object-cover shadow-xl md:-mt-10 md:max-h-[480px]"
            loading="eager"
            fetchpriority="high"
          />
        )
      }

      <div class="prose-ira mt-12">
        <Content />
      </div>

      {
        tags.length > 0 && (
          <div class="mt-12 border-t border-line pt-8">
            <h2 class="sr-only">Tags</h2>
            <ul class="flex flex-wrap gap-2">
              {tags.map((t) => (
                <li>
                  <a href={`/tag/${t.slug}/`} class="inline-block rounded-full bg-soft px-3 py-1.5 text-sm text-ink transition hover:bg-amber-500 hover:text-white">
                    #{t.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        )
      }

      <aside class="mt-12 grid items-center gap-6 rounded-2xl bg-teal-900 p-6 text-white sm:grid-cols-[96px_1fr] md:p-8" aria-label="About the author">
        <Image src={timPhoto} alt="Tim Berry" width={192} class="size-24 rounded-full bg-teal-700 object-cover object-top" />
        <div>
          <p class="text-xs font-semibold tracking-wide text-amber-500 uppercase">About the author</p>
          <p class="mt-1 font-serif text-2xl font-semibold">Tim Berry</p>
          <p class="mt-2 text-sm leading-relaxed text-white/85">
            Attorney focused on self-directed IRAs and 401(k)s since 1997. Tim helps clients nationwide fix rollover
            mistakes, avoid prohibited transactions and stay compliant.
          </p>
          <a href={BOOKING_URL} class="btn mt-5">Book An Appointment <span aria-hidden="true">→</span></a>
        </div>
      </aside>

      <nav class="mt-10 grid gap-4 sm:grid-cols-2" aria-label="More articles">
        {
          older ? (
            <a href={postUrl(older)} class="rounded-xl border border-line p-5 transition hover:border-amber-500">
              <span class="text-xs font-semibold text-muted uppercase">← Older</span>
              <span class="mt-1 block font-semibold text-ink">{older.data.title}</span>
            </a>
          ) : <span />
        }
        {
          newer && (
            <a href={postUrl(newer)} class="rounded-xl border border-line p-5 text-right transition hover:border-amber-500">
              <span class="text-xs font-semibold text-muted uppercase">Newer →</span>
              <span class="mt-1 block font-semibold text-ink">{newer.data.title}</span>
            </a>
          )
        }
      </nav>
    </div>
  </article>

  <section class="bg-soft py-16 md:py-20" aria-labelledby="related-heading">
    <div class="container-site">
      <h2 id="related-heading" class="text-3xl font-semibold md:text-4xl">Related Articles</h2>
      <ul class="mt-10 grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {related.map((p) => <li><PostCard post={p} /></li>)}
      </ul>
    </div>
  </section>
</Base>
