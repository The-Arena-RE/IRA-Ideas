---
import Base from '../layouts/Base.astro';
---

<Base title="Page Not Found | IRA Ideas LLC" description="The page you were looking for could not be found." noindex>
  <section class="py-24 md:py-32">
    <div class="container-site text-center">
      <p class="eyebrow">404</p>
      <h1 class="mt-3 text-4xl font-semibold md:text-5xl">This page took an early withdrawal.</h1>
      <p class="mx-auto mt-6 max-w-lg">The page you’re looking for doesn’t exist or has moved.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href="/" class="btn">Back to Home <span aria-hidden="true">→</span></a>
        <a href="/get-in-touch-ira-401k-attorney/" class="btn bg-teal-900 hover:bg-teal-950">Contact Tim</a>
      </div>
    </div>
  </section>
</Base>
