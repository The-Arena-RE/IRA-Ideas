---
import Base from '../layouts/Base.astro';
import policy from '../content/privacy-policy.html?raw';
---

<Base title="Privacy Policy | IRA Ideas LLC" description="How IRA Ideas LLC collects, uses, stores, and discloses personal information." hideCta>
  <section class="bg-teal-950 py-16 text-white md:py-20">
    <div class="container-site">
      <p class="eyebrow text-amber-500">IRA Ideas</p>
      <h1 class="mt-3 font-sans text-4xl font-bold text-white md:text-5xl">Privacy Policy</h1>
    </div>
  </section>
  <article class="container-site prose-legal max-w-3xl py-14 md:py-20" set:html={policy} />
</Base>
