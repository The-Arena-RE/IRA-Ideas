---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, tagIndex, type Post } from '../../lib/blog';

export const getStaticPaths = (async () => {
  const posts = await getPosts();
  return [...tagIndex(posts).values()].map((t) => ({ params: { tag: t.slug }, props: { name: t.name, posts: t.posts } }));
}) satisfies GetStaticPaths;

const { name, posts } = Astro.props as { name: string; posts: Post[] };
---

<Base
  title={`${name} – Articles | IRA Ideas LLC`}
  description={`Articles by attorney Tim Berry tagged “${name}”: self-directed IRA and 401(k) rules, court cases and IRS rulings.`}
>
  <section class="bg-teal-950 py-14 text-white md:py-20">
    <div class="container-site">
      <a href="/blog/" class="text-sm text-white/70 hover:text-amber-500">← All articles</a>
      <p class="eyebrow mt-6 text-amber-500">Topic</p>
      <h1 class="mt-2 font-sans text-4xl font-bold text-white md:text-5xl">{name}</h1>
      <p class="mt-4 text-white/80">{posts.length} {posts.length === 1 ? 'article' : 'articles'}</p>
    </div>
  </section>
  <section class="py-16 md:py-20">
    <div class="container-site">
      <ul class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => <li><PostCard post={post} /></li>)}
      </ul>
    </div>
  </section>
</Base>
