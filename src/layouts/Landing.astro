---
// Standalone layout for funnel / landing pages: no site header or footer,
// matching the full-width "canvas" pages on the WordPress site.
import '../styles/landing.css';
import Head from '../components/Head.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  noindex?: boolean;
}

const { title, description, image, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en-US">
  <head>
    <Head title={title} description={description} image={image} noindex={noindex} />
    <slot name="head" />
  </head>
  <body>
    <main id="main">
      <slot />
    </main>
  </body>
</html>
