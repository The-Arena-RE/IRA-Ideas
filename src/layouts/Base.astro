---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CtaBand from '../components/CtaBand.astro';
import Head from '../components/Head.astro';

interface Props {
  title: string;
  description: string;
  /** Hide the "Take the First Step" band above the footer. */
  hideCta?: boolean;
  noindex?: boolean;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
}

const { title, description, hideCta = false, noindex = false, ...seo } = Astro.props;
---

<!doctype html>
<html lang="en-US">
  <head>
    <Head title={title} description={description} noindex={noindex} {...seo} />
    <slot name="head" />
  </head>
  <body class="flex min-h-screen flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:px-4 focus:py-2 focus:text-ink">
      Skip to content
    </a>
    <Header />
    <main id="main" class="flex-1">
      <slot />
    </main>
    {!hideCta && <CtaBand />}
    <Footer />
  </body>
</html>
