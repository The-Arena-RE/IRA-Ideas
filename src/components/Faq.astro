---
import { faqs } from '../data/site';
import Icon from './Icon.astro';
---

<section class="py-20 md:py-24" aria-labelledby="faq-heading">
  <div class="container-site grid items-center gap-12 lg:grid-cols-2">
    <div>
      <p class="eyebrow">FAQs</p>
      <h2 id="faq-heading" class="mt-3 text-4xl font-semibold md:text-[48px]">Frequently Asked Questions</h2>
      <p class="mt-6 max-w-md">
        Find clear answers to common questions about self-directed IRAs and 401(k)s, including rules, compliance, and
        investment options, explained simply to help you move forward with confidence.
      </p>
    </div>

    <div class="space-y-3">
      {
        faqs.map((f, i) => (
          <details class="group bg-teal-900 text-white shadow-md" open={i === 0}>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-[15px] font-medium [&::-webkit-details-marker]:hidden">
              {f.q}
              <Icon name="chevron" class="size-4 shrink-0 transition-transform group-open:rotate-180" />
            </summary>
            <p class="border-t border-white/10 px-5 py-4 text-[15px] leading-relaxed text-white/85">{f.a}</p>
          </details>
        ))
      }
    </div>
  </div>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    })}
  />
</section>
