---
import { Image } from 'astro:assets';
import { postUrl, formatDate, readingTime, type Post } from '../lib/blog';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const { title, description, pubDate, image, imageAlt, tags } = post.data;
const href = postUrl(post);
---

<article class="group relative flex h-full flex-col overflow-hidden rounded-xl border border-line bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
  <div class="relative aspect-[16/9] overflow-hidden bg-teal-950">
    {
      image ? (
        <Image
          src={image}
          alt={imageAlt ?? ''}
          widths={[400, 640, 800]}
          sizes="(min-width: 1024px) 420px, (min-width: 640px) 50vw, 100vw"
          class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
        />
      ) : (
        <div class="flex h-full w-full flex-col justify-end bg-[radial-gradient(circle_at_85%_15%,#256b64_0%,#0c4342_45%,#003a3a_100%)] p-5">
          <span class="font-serif text-5xl leading-none font-bold text-amber-500/90" aria-hidden="true">“</span>
          <span class="mt-2 line-clamp-2 font-serif text-lg leading-snug text-white/90" aria-hidden="true">{title}</span>
        </div>
      )
    }
  </div>
  <div class="flex flex-1 flex-col p-6">
    <p class="text-xs font-semibold tracking-wide text-teal-700 uppercase">
      <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
      <span aria-hidden="true"> · </span>{readingTime(post)} min read
    </p>
    <h3 class="mt-2 font-sans text-lg leading-snug font-bold text-ink">
      <a href={href} class="after:absolute after:inset-0 hover:text-teal-700">{title}</a>
    </h3>
    <p class="mt-3 line-clamp-3 flex-1 text-[15px] leading-relaxed text-body">{description}</p>
    {
      tags.length > 0 && (
        <p class="mt-4 truncate text-xs text-muted">{tags.slice(0, 3).map((t) => t.name).join(' · ')}</p>
      )
    }
    <span class="mt-4 text-sm font-medium text-amber-600 group-hover:text-amber-700">Read article <span aria-hidden="true">→</span></span>
  </div>
</article>
