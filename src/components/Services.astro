---
import { getImage } from 'astro:assets';
import bg from '../assets/img/business-lady.jpg';
import { services, BOOKING_URL } from '../data/site';

const bgImg = await getImage({ src: bg, width: 1920, format: 'webp' });
---

<section
  id="services"
  class="relative overflow-hidden rounded-t-[28px] rounded-br-[28px] bg-slate-900 bg-cover bg-center py-20 md:py-24"
  style={`background-image: linear-gradient(rgba(22,38,45,.93), rgba(20,36,43,.93)), url(${bgImg.src});`}
  aria-labelledby="services-heading"
>
  <div class="container-site">
    <div class="text-center">
      <h2 id="services-heading" class="text-[28px] font-normal text-white md:text-[35px]">
        I <span class="text-amber-500">specialize</span> in assisting clients with:
      </h2>
      <span class="mx-auto mt-4 block h-0.5 w-16 bg-amber-500" aria-hidden="true"></span>
      <p class="mt-6 text-sm text-white/85">Helping Clients Navigate Complex Legal Matters</p>
    </div>

    <ul class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((s) => (
          <li class="flex flex-col border-[5px] border-white/30 bg-card p-6 shadow-lg transition hover:-translate-y-1">
            <h3 class="font-sans text-[17px] font-bold text-ink">{s.title}</h3>
            <span class="mt-3 block h-0.5 w-10 bg-amber-500" aria-hidden="true" />
            <p class="mt-4 flex-1 text-[15px] leading-relaxed text-body [&_strong]:text-ink" set:html={s.body} />
            <a href={BOOKING_URL} class="mt-5 text-[15px] text-amber-600 hover:text-amber-700">
              Book An Appointment <span aria-hidden="true">→</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
