---
import { Image } from 'astro:assets';
import logo from '../assets/img/logo.png';
import { site, BOOKING_URL } from '../data/site';
import Icon from './Icon.astro';

const year = new Date().getFullYear();
---

<footer class="rounded-t-[28px] bg-navy-950 text-white">
  <div class="container-site grid gap-10 py-14 md:grid-cols-3 md:items-start">
    <div>
      <Image src={logo} alt="IRA Ideas LLC" width={170} class="h-auto w-[150px]" />
      <p class="mt-5 max-w-xs text-sm leading-relaxed text-white/90">{site.tagline}</p>
    </div>

    <div>
      <h2 class="font-sans text-xl font-medium text-white">Get In Touch</h2>
      <ul class="mt-5 space-y-3 text-sm">
        <li class="flex items-start gap-3">
          <Icon name="location" class="mt-0.5 size-4 shrink-0 text-amber-500" />
          <span>{site.address}</span>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="mail" class="mt-0.5 size-4 shrink-0 text-amber-500" />
          <a href={`mailto:${site.email}`} class="hover:text-amber-500">{site.email}</a>
        </li>
        <li class="flex items-start gap-3">
          <Icon name="phone" class="mt-0.5 size-4 shrink-0 text-amber-500" />
          <a href={site.phoneHref} class="hover:text-amber-500">{site.phone}</a>
        </li>
      </ul>
    </div>

    <div class="md:justify-self-end md:self-center">
      <a href={BOOKING_URL} class="btn">Book An Appointment <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="container-site flex items-center justify-between gap-4 border-t border-white/15 py-5 text-xs font-medium">
    <p>
      © {year} IRA IDEAS LLC | Designed &amp; Powered by
      <a href="https://aireprokit.com/" target="_blank" rel="noopener noreferrer" class="text-amber-500 hover:underline">AireProKit</a>
    </p>
    <div class="flex items-center gap-5">
      <a href="/privacy-policy/" class="whitespace-nowrap text-amber-500 hover:underline">Privacy Policy</a>
      <a
        href={site.youtube}
        target="_blank"
        rel="noopener"
        aria-label="Tim Berry on YouTube"
        class="grid size-10 place-items-center rounded-full bg-amber-500 text-navy-950 transition hover:scale-105 hover:bg-amber-600"
      >
        <Icon name="youtube" class="size-6" />
      </a>
    </div>
  </div>
</footer>
