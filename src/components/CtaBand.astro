---
import { BOOKING_URL } from '../data/site';
---

<section class="bg-card px-4 py-16 md:py-24" aria-labelledby="cta-heading">
  <div class="mx-auto max-w-[1300px] rounded-[36px] bg-charcoal px-6 py-16 text-center md:px-12 md:py-24">
    <h2
      id="cta-heading"
      class="font-display text-[34px] leading-[1.05] font-extrabold tracking-tight text-white sm:text-5xl lg:text-[70px]"
    >
      Take the First Step Toward <span class="block text-amber-500">Smarter Retirement Investing</span>
    </h2>
    <p class="mx-auto mt-8 max-w-3xl text-white">
      Schedule a consultation to see if a self-directed IRA or 401(k) strategy is right for you. Get clear legal
      guidance, answers to your questions, and a roadmap to structure compliant retirement investments with
      confidence.
    </p>
    <a href={BOOKING_URL} class="btn mt-10">Book An Appointment <span aria-hidden="true">→</span></a>
  </div>
</section>
